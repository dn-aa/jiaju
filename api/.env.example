# TP 全屋家居 · 后端环境变量模板（复制为 .env 使用）
# 本地默认值可开箱即用；生产必须替换 JWT_SECRET 与数据库口令

DATABASE_URL=mysql+pymysql://root:tp_home_dev@127.0.0.1:3306/tp_home_dev?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0

JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=7d

STORAGE_KIND=local
# OSS_ENDPOINT=
# OSS_BUCKET=
# OSS_KEY=
# OSS_SECRET=

CORS_ORIGINS=http://localhost:5173,http://localhost:5174

CAPTCHA_ENABLED=true
