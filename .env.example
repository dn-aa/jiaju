# ============================================================
# TP 全屋家居 · 环境变量模板（复制为 .env 后按需修改；真实密钥不入库）
# 后端实际读取 api/.env（见 api/.env.example）；本文件为总览
# ============================================================

# ---------- 数据库（MySQL 8.0） ----------
# 本地 Docker Compose（deploy/docker-compose.yml）默认值：
#   用户 root / 密码 tp_home_dev / 库 tp_home_dev
# 便携版（.tools/mysql）默认值：root / tp_home_dev / tp_home_dev
DATABASE_URL=mysql+pymysql://root:tp_home_dev@127.0.0.1:3306/tp_home_dev?charset=utf8mb4

# ---------- Redis 7 ----------
REDIS_URL=redis://127.0.0.1:6379/0

# ---------- JWT（生产必须更换为强随机密钥） ----------
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=7d

# ---------- 文件存储 ----------
# local（开发：写入 uploads/，Nginx 别名暴露）/ s3（生产：S3 兼容或腾讯云 COS）
STORAGE_KIND=local
# 生产（s3）时配置：
# OSS_ENDPOINT=
# OSS_BUCKET=
# OSS_KEY=
# OSS_SECRET=

# ---------- 跨域（生产放行前台/后台域名） ----------
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# ---------- 表单防刷 ----------
CAPTCHA_ENABLED=true
