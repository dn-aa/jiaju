# ============================================================
# TP 全屋家居 · 生产环境变量模板（复制为 deploy/.env 使用）
#  ⚠️ 生产必须修改：JWT_SECRET / MYSQL_ROOT_PASSWORD
# ============================================================

# --- 数据库（MySQL 8.0）---
MYSQL_ROOT_PASSWORD=change-me-strong-password
MYSQL_DATABASE=tp_home_prod

# --- 认证 ---
# 生成方式：openssl rand -hex 32
JWT_SECRET=change-me-64-hex-characters
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=7d

# --- 存储（local=本地磁盘 / oss=对象存储）---
STORAGE_KIND=local
# 切换 OSS（腾讯云 COS 兼容 S3）时启用：
# OSS_ENDPOINT=https://cos.ap-guangzhou.myqcloud.com
# OSS_BUCKET=tp-home-uploads
# OSS_KEY=AKIDxxxx
# OSS_SECRET=xxxx

# --- 跨域（生产走同域 Nginx 反代时可收紧为站点域名）---
CORS_ORIGINS=http://localhost:8080,http://localhost:8081

# --- 图形验证码开关 ---
CAPTCHA_ENABLED=true

# --- 备案与地图（上线前补充）---
# ICP_BEIAN_NO=粤ICP备XXXXXXXX号
# TENCENT_MAP_KEY=请申请腾讯位置服务 Key
